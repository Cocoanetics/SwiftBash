// Tiny systemLibrary module that exposes the host's zlib to Swift.
//
// macOS / iOS / tvOS / watchOS — the SDK already ships <zlib.h>
// and `libz.dylib` (used internally by Compression framework, AFC,
// the codesign tooling, and many other system libraries). The
// `link "z"` directive picks up the right path automatically.
//
// Linux — `zlib1g` (runtime) is installed by default on Ubuntu;
// `zlib1g-dev` (headers) needs to be added to the CI image and
// any developer's environment that wants to build the package.
module CZlib [system] {
    header "shim.h"
    link "z"
    export *
}
